PORT=3000
DATABASE_URL=postgres://usuario:contraseña@host:5432/base
JWT_SECRETO=cadena_aleatoria_larga
JWT_EXPIRACION=1d
REGISTRO_HABILITADO=true
ADDONS_CLAVE=64_caracteres_hexadecimales
# Token de lectura de la API de TMDB (themoviedb.org → Configuración → API)
TMDB_TOKEN=token_de_lectura_de_tmdb
# Proxies delante del backend, para el límite de pedidos por IP
PROXIES_CONFIABLES=0
