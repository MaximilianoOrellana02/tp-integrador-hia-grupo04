{
  "name": "maxflix-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "npm run db:migrar && node src/server.js",
    "db:migrar": "sequelize db:migrate --config src/db/config.js --migrations-path src/db/migraciones",
    "db:deshacer": "sequelize db:migrate:undo --config src/db/config.js --migrations-path src/db/migraciones",
    "db:nueva-migracion": "sequelize migration:generate --migrations-path src/db/migraciones --name",
    "hacer-admin": "node --env-file-if-exists=.env src/scripts/hacerAdmin.js",
    "crear-cuenta": "node --env-file-if-exists=.env src/scripts/crearCuenta.js",
    "exportar-avatares": "node --env-file-if-exists=.env src/scripts/exportarAvatares.js",
    "importar-avatares": "node --env-file-if-exists=.env src/scripts/importarAvatares.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  }
}
